# Odysseus — Windows CLIENT configuration
# Copy to .env on the Windows laptop, then fill in REMOTE_SERVER_URL and
# REMOTE_SERVER_KEY with the Mac Studio's values.
#
# After setup, add a ModelEndpoint in Odysseus Settings UI:
#   URL:   http://<mac-studio-ip>:7000/inference/v1/chat/completions
#   Key:   (same as REMOTE_SERVER_KEY below)
# Odysseus will treat it as any other OpenAI-compatible endpoint.

# ============================================================
# Inference proxy (client mode — informational only)
# ============================================================

INFERENCE_SERVER_MODE=client

# Mac Studio address and shared secret (must match INFERENCE_SERVER_KEY on server).
REMOTE_SERVER_URL=http://mac-studio.local:7000
REMOTE_SERVER_KEY=replace_with_same_token_as_server

# ============================================================
# LLM — point directly at Mac Studio proxy for local models.
# You can still add a separate LLM_HOST for a local Ollama if the
# Windows box also runs one.
# ============================================================
LLM_HOST=localhost

# ============================================================
# Auth & Security
# ============================================================
AUTH_ENABLED=true
LOCALHOST_BYPASS=false

# ============================================================
# Optional — fill as needed
# ============================================================
# SEARXNG_INSTANCE=http://localhost:8080
# DATABASE_URL=sqlite:///./data/app.db
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot
