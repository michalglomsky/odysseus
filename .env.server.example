# Odysseus — Mac Studio SERVER configuration
# Copy to .env on the Mac Studio, then fill in INFERENCE_SERVER_KEY.
#
# The server runs Odysseus for local use AND exposes a /inference/v1/*
# proxy that Windows can call. Ollama stays on localhost:11434 only.

# ============================================================
# Inference proxy
# ============================================================

# Enable the /inference/v1/* proxy router.
INFERENCE_SERVER_MODE=server

# Secret shared with the Windows client. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this out of git — add .env to .gitignore.
INFERENCE_SERVER_KEY=replace_with_a_strong_random_token

# Where Odysseus listens. 0.0.0.0 lets the Windows laptop reach it.
# Pair with a firewall rule or Tailscale if you don't want LAN exposure.
APP_BIND=0.0.0.0
APP_PORT=7000

# ============================================================
# LLM (local Ollama — stays on loopback)
# ============================================================
LLM_HOST=localhost

# ============================================================
# Auth & Security
# ============================================================
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# ============================================================
# Optional — fill as needed
# ============================================================
# SEARXNG_INSTANCE=http://localhost:8080
# DATABASE_URL=sqlite:///./data/app.db
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot
